{
  "name": "personal-paper-library",
  "version": "2.23.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:preview": "wrangler dev --env preview",
    "build": "wrangler deploy --dry-run --env=\"\"",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test",
    "test": "vitest run",
    "version:check": "node scripts/version-policy.mjs check",
    "version:next": "node scripts/version-policy.mjs next",
    "version:bump": "node scripts/version-policy.mjs bump",
    "version:release": "node scripts/version-policy.mjs release",
    "test:watch": "vitest",
    "cf:dev": "wrangler dev",
    "cf:dev:preview": "wrangler dev --env preview",
    "cf:deploy": "wrangler deploy",
    "cf:deploy:preview": "wrangler deploy --env preview",
    "cf:migrate": "wrangler d1 migrations apply personal-paper-library --remote",
    "cf:migrate:preview": "wrangler d1 migrations apply personal-paper-library-preview --remote --env preview",
    "cf:tail": "wrangler tail",
    "cf:tail:preview": "wrangler tail --env preview",
    "cf:test-pdf-extractor": "node scripts/test-worker-pdf-extractor.mjs"
  },
  "dependencies": {
    "hono": "^4.9.7",
    "jose": "^6.2.12",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "better-sqlite3": "^12.11.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.129.1"
  }
}
