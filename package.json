{
  "name": "personal-paper-library",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "local": "./scripts/start-local.sh",
    "build": "tsc && node scripts/copy-public.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/migrate.ts",
    "metadata:backfill": "tsx src/db/backfill-metadata.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "better-sqlite3": "^12.4.1",
    "hono": "^4.9.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
