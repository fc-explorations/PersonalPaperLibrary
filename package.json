{
  "name": "personal-paper-library",
  "version": "2.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "local": "./scripts/start-local.sh",
    "build": "tsc && node scripts/copy-public.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test",
    "test": "vitest run",
    "version:check": "node scripts/version-policy.mjs check",
    "version:next": "node scripts/version-policy.mjs next",
    "version:bump": "node scripts/version-policy.mjs bump",
    "version:release": "node scripts/version-policy.mjs release",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/migrate.ts",
    "metadata:backfill": "npm run build && node dist/src/db/backfill-metadata.js",
    "cf:dev": "wrangler dev",
    "cf:dev:preview": "wrangler dev --env preview",
    "cf:deploy": "wrangler deploy",
    "cf:deploy:preview": "wrangler deploy --env preview",
    "cf:migrate": "wrangler d1 migrations apply personal-paper-library --remote",
    "cf:migrate:preview": "wrangler d1 migrations apply personal-paper-library-preview --remote --env preview",
    "cf:tail": "wrangler tail",
    "cf:tail:preview": "wrangler tail --env preview",
    "cf:test-pdf-extractor": "node scripts/test-worker-pdf-extractor.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.4.1",
    "busboy": "^1.6.0",
    "hono": "^4.9.7",
    "jose": "^6.2.12",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/busboy": "^1.5.4",
    "@types/node": "^24.3.0",
    "@types/unzipper": "^0.10.11",
    "tsx": "^4.19.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.129.1"
  }
}
